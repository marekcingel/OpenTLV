{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Benchmark: Build and run",
            "type": "process",
            "command": "python3",
            "windows": {
                "command": "python"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "group": "test",
            "args": [
                "${workspaceFolder}/scripts/benchmarks.py",
                "run"
            ]
        },
        {
            "label": "Benchmark: Compare baseline with last",
            "type": "process",
            "command": "python3",
            "windows": {
                "command": "python",
                "args": [
                    "${workspaceFolder}/scripts/benchmarks.py",
                    "compare",
                    "--baseline",
                    "${workspaceFolder}/benchmarks/baselines/windows-msvc-x64.json"
                ]
            },
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "args": [
                "${workspaceFolder}/scripts/benchmarks.py",
                "compare"
            ]
        },
        {
            "label": "Benchmark: Update baseline from last",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/benchmarks.py",
                "baseline"
            ],
            "problemMatcher": [],
            "windows": {
                "command": "python",
                "args": [
                    "${workspaceFolder}/scripts/benchmarks.py",
                    "baseline",
                    "--baseline",
                    "${workspaceFolder}/benchmarks/baselines/windows-msvc-x64.json"
                ]
            }
        }
    ]
}
