    run_cli(0 "${doc_head},\"format\":\"der\",\"elements\":[{\"tag\":\"04\",\"value\":\"AA\"}],\"complete\":true,\"skipped\":[]}\n" "" decode --format der --hex "0401AA" --recover)
endif()
