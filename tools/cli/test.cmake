# Encode -> dump round trips, through hex text and through binary files.
function(round_trip format tag value)
    execute_process(COMMAND "${CLI}" encode --format "${format}" --tag "${tag}" --value "${value}"
        RESULT_VARIABLE result OUTPUT_VARIABLE hex ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "encode ${format} ${tag}: ${result} ${error}")
    endif()
    string(STRIP "${hex}" hex)
    check(0 "offset=0 tag=${tag} length=" dump --format "${format}" --hex "${hex}")
    check(0 "value=${value}" dump --format "${format}" --hex "${hex}")
    set(bin "${CMAKE_CURRENT_BINARY_DIR}/encode-roundtrip.bin")
    execute_process(COMMAND "${CLI}" encode --format "${format}" --tag "${tag}" --value "${value}"
        --output-encoding binary OUTPUT_FILE "${bin}" RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "binary encode ${format} ${tag}: ${result} ${error}")
    endif()
    file(READ "${bin}" binary_hex HEX)
    string(TOUPPER "${binary_hex}" binary_hex)
    if(NOT binary_hex STREQUAL hex)
        message(FATAL_ERROR "binary output ${binary_hex} differs from hex output ${hex}")
    endif()
    check(0 "value=${value}" dump --format "${format}" --input "${bin}")
    file(REMOVE "${bin}")
endfunction()

