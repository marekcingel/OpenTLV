# Package contents come exclusively from the canonical install() rules.
set(CPACK_PACKAGE_NAME "${PROJECT_NAME}")
set(CPACK_PACKAGE_VENDOR "OpenTLV contributors")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Allocation-free C and C++ TLV library")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
if(OPENTLV_VERSION_PRERELEASE)
    string(APPEND CPACK_PACKAGE_VERSION "-${OPENTLV_VERSION_PRERELEASE}")
endif()
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_FILE_NAME
    "${CPACK_PACKAGE_NAME}-${CPACK_PACKAGE_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}-${CMAKE_C_COMPILER_ID}")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/packages")
set(CPACK_VERBATIM_VARIABLES YES)
if(NOT CPACK_GENERATOR)
    if(WIN32)
        set(CPACK_GENERATOR ZIP)
    else()
        set(CPACK_GENERATOR TGZ)
    endif()
endif()
include(CPack)
