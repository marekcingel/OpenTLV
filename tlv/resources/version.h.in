#ifndef OPENTLV_VERSION_H
#define OPENTLV_VERSION_H

/**
 * @file
 * @brief Generated library version metadata.
 * @ingroup core
 */


#include "tlv/export.h"
#include <stdint.h>

/** @addtogroup core
 * @{
 */

/* clang-format off */
#define OPENTLV_VERSION_MAJOR @OPENTLV_VERSION_MAJOR@
#define OPENTLV_VERSION_MINOR @OPENTLV_VERSION_MINOR@
#define OPENTLV_VERSION_PATCH @OPENTLV_VERSION_PATCH@
#define OPENTLV_VERSION_REVISION @OPENTLV_VERSION_REVISION@

#define OPENTLV_VERSION_PRERELEASE "@OPENTLV_VERSION_PRERELEASE@"
#define OPENTLV_VERSION_STRING "@OPENTLV_VERSION_STRING@"

#define OPENTLV_GIT_COMMIT_HASH "@OPENTLV_GIT_COMMIT_HASH@"
#define OPENTLV_GIT_BRANCH "@OPENTLV_GIT_BRANCH@"
#define OPENTLV_GIT_TAG "@OPENTLV_GIT_TAG@"
#define OPENTLV_GIT_REPO_VERSION "@OPENTLV_GIT_REPO_VERSION@"
/* clang-format on */

#ifdef __cplusplus
extern "C" {
#endif

TLV_API uint32_t tlv_version_major(void);
TLV_API uint32_t tlv_version_minor(void);
TLV_API uint32_t tlv_version_patch(void);
TLV_API uint64_t tlv_version_revision(void);

/**
 * @brief Returns the linked library's prerelease label.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_prerelease(void);
/**
 * @brief Returns the linked library's complete version string.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_string(void);
/**
 * @brief Returns the linked library's Git commit hash.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_git_commit_hash(void);
/**
 * @brief Returns the linked library's Git branch name.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_git_branch(void);
/**
 * @brief Returns the linked library's Git tag.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_git_tag(void);
/**
 * @brief Returns the linked library's Git describe metadata.
 * @return A static NUL-terminated string, never NULL; do not free or modify it.
 */
TLV_API const char* tlv_version_git_repo(void);

#ifdef __cplusplus
}
#endif

/** @} */

#endif /* OPENTLV_VERSION_H */
