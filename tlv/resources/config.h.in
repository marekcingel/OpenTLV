#ifndef OPENTLV_CONFIG_H
#define OPENTLV_CONFIG_H

/**
 * @file
 * @brief Generated library feature configuration.
 * @ingroup core
 */


#include "tlv/export.h"

/** @addtogroup core
 * @{
 */

#cmakedefine01 OPENTLV_BLUETOOTH
#cmakedefine01 OPENTLV_NFC
#cmakedefine01 OPENTLV_DHCP
#cmakedefine01 OPENTLV_LLDP
#cmakedefine01 OPENTLV_FORMAT_ASN1
#cmakedefine01 OPENTLV_FORMAT_BER
#cmakedefine01 OPENTLV_FORMAT_DER
#cmakedefine01 OPENTLV_FORMAT_CER
#cmakedefine01 OPENTLV_EMV
#cmakedefine01 OPENTLV_DOCUMENT

#ifdef __cplusplus
extern "C" {
#endif

/* Runtime mirrors of the OPENTLV_* macros above: 1 if the component was
 * compiled into this build of the library, 0 otherwise. Useful when the
 * compiled configuration is not known at the consumer's compile time. */
/**
 * @brief Reports availability of the Bluetooth extension.
 * @return 1 if formats, containers, definitions, schemas and codecs for
 *         Bluetooth were built, or 0 if `OPENTLV_BLUETOOTH` was disabled.
 */
TLV_API int tlv_config_bluetooth(void);
/** @brief Reports whether LLDP framing and definitions were built.
 * @return 1 if `OPENTLV_LLDP` was enabled, otherwise 0.
 */
TLV_API int tlv_config_lldp(void);
/**
 * @brief Reports whether DHCPv4 option framing was built.
 * @return 1 if `OPENTLV_DHCP` was enabled, otherwise 0.
 */
TLV_API int tlv_config_dhcp(void);
/** @brief Reports whether NFC Type 2 Tag framing was built.
 * @return 1 if `OPENTLV_NFC` was enabled, otherwise 0.
 */
TLV_API int tlv_config_nfc(void);
TLV_API int tlv_config_format_asn1(void);
TLV_API int tlv_config_format_ber(void);
TLV_API int tlv_config_format_der(void);
TLV_API int tlv_config_format_cer(void);
/**
 * @brief Reports whether native EMV capabilities were built.
 * @return 1 if `OPENTLV_EMV` was enabled, otherwise 0.
 */
TLV_API int tlv_config_emv(void);
TLV_API int tlv_config_document(void);

#ifdef __cplusplus
}
#endif

/** @} */

#endif
